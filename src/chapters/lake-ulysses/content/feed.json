  "channels": [
    {
      "id": "ad",
      "name": "FEELZ",
      "tag": "AD",
      "art": "feelzSilhouette",
      "beats": [
        {
          "speaker": "FEELZ",
          "text": "Meet FEELZ. The county's free emotional wellness companion.",
          "comments": [
            {
              "who": "dusty_ray",
              "text": "free??"
            },
            {
              "who": "jessrn",
              "text": "it installed itself on my moms phone"
            }
          ]
        },
        {
          "speaker": "FEELZ",
          "text": "Eight feelings. One wheel. Spin it, and find yourself.",
          "comments": [
            {
              "who": "nightcrawler",
              "text": "i only have like three"
            }
          ]
        },
        {
          "speaker": "FEELZ",
          "text": "Four little batteries, right up top. FEELZ keeps them charged, so you can keep showing up.",
          "comments": [
            {
              "who": "lakelady",
              "text": "mine is at 2 rn"
            },
            {
              "who": "trout_dad",
              "text": "relatable"
            }
          ]
        },
        {
          "speaker": "FEELZ",
          "text": "Talk to a licensed provider in minutes. Real people. Real-ish hours.",
          "comments": [
            {
              "who": "jessrn",
              "text": "my therapist hung up on me mid sentence"
            },
            {
              "who": "dusty_ray",
              "text": "@{handle} same"
            }
          ]
        },
        {
          "speaker": "FEELZ",
          "text": "Your lake, live in your pocket. Clear water. Happy fish.",
          "comments": [
            {
              "who": "nightcrawler",
              "text": "why do they keep saying lake"
            }
          ]
        },
        {
          "speaker": "FEELZ",
          "text": "FEELZ never judges. FEELZ just {slow}measures.{/slow}",
          "comments": [
            {
              "who": "lakelady",
              "text": "thats what bob said"
            },
            {
              "who": "trout_dad",
              "text": "ok that's a little creepy"
            }
          ]
        },
        {
          "speaker": "FEELZ",
          "text": "FEELZ. Because how you feel is everyone's business.",
          "comments": [
            {
              "who": "jessrn",
              "text": "wait what"
            },
            {
              "who": "dusty_ray",
              "text": "read that again"
            }
          ]
        },
        {
          "text": "FEELZ is provided by the County of Lake Ulysses. Your data may be shared with county partners, sponsors, and the Lord.",
          "holdMs": 6000,
          "comments": [
            {
              "who": "nightcrawler",
              "text": "AND THE LORD??"
            },
            {
              "who": "lakelady",
              "text": "lmao"
            }
          ]
        }
      ]
