    {
      "text": "It always does. Right before it isn't.",
      "loop": "lake",
      "bgAnim": "loop_lake"
    },
    {
      "text": "{pause:400}You wake up on the shoulder of Lakeshore Drive.{pause:300} Ears ringing.{sfx:gravel} Clothes damp.",
      "loop": "road"
