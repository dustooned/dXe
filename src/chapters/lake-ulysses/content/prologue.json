    {
      "text": "Lake Ulysses. Three thousand acres, they call it. A jewel.",
      "loop": "lake",
      "bgAnim": "loop_lake"
    },
    {
      "text": "{slow}The water looks fine today.{/slow}",
      "loop": "lake",
      "bgAnim": "loop_lake"
